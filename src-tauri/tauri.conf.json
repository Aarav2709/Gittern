{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gittern",
  "version": "0.1.0",
  "identifier": "dev.gittern.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Gittern", "width": 1320, "height": 860, "minWidth": 420, "minHeight": 360 }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; media-src 'none'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
